  noteContent: "\u041A\u043E\u0433\u0434\u0430 \u0432\u0441\u0435 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B
    \u0431\u0443\u0434\u0443\u0442 \u0441\u043E\u0431\u0440\u0430\u043D\u044B, \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438
    \u0441 \u0442\u0435\u043C, \u043A\u0442\u043E \u0441\u0442\u043E\u0438\u0442
    \u0443 \u0441\u0432\u0435\u0442\u043E\u0432\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0430.
    \u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u0434\u0432\u0435\u0440\u044C
    \u043F\u0440\u0438\u043C\u0435\u0442 \u0442\u0435\u0431\u044F."
