  npcName: "\u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0430\u0440\u0445\u0438\u0432\u0430"
  openingLine: "\u0422\u044B \u0441\u043E\u0431\u0440\u0430\u043B \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    \u0442\u0438\u0448\u0438\u043D\u044B, \u0447\u0442\u043E\u0431\u044B \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
    \u0430\u0440\u0445\u0438\u0432. \u0427\u0442\u043E \u0438\u0449\u0435\u0448\u044C?"
  answers:
  - "\u041A\u0430\u043A \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0434\u0432\u0435\u0440\u044C?"
  - "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0441
    \u0433\u043E\u0440\u043E\u0434\u043E\u043C?"
  responses:
  - "\u0414\u0432\u0435\u0440\u044C \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
    \u043D\u0435 \u043A\u043B\u044E\u0447, \u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u0443\u044E
    \u0438\u0441\u0442\u043E\u0440\u0438\u044E: \u0441\u043E\u0431\u0435\u0440\u0438
    \u0432\u0441\u0435 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B \u0438
    \u0432\u0435\u0440\u043D\u0438\u0441\u044C \u043A\u043E \u043C\u043D\u0435."
  - "\u0413\u043E\u0440\u043E\u0434 \u043D\u0435 \u043F\u043E\u0433\u0438\u0431.
    \u041E\u043D \u0432\u044B\u0436\u0438\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0434\u043E\u043B\u0433\u043E \u0438 \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F
    \u0437\u0430\u0431\u044B\u0432\u0430\u0442\u044C \u0431\u043E\u043B\u044C \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
    \u0447\u0435\u043C \u0438\u043C\u0435\u043D\u0430."
  highlightColor: {r: 0.85, g: 0.42, b: 1, a: 1}
  highlightLight: {fileID: 1834791852}
  prompt: E - speak with the keeper
