  m_Script: {fileID: 11500000, guid: 61f7cf113be67c24e82b5a3a9e484f52, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Lab4Narrative.Note
  noteTitle: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 III: \u0413\u043E\u043B\u043E\u0441
    \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044F"
  noteContent: "\u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u043D\u0435
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0443\u0442\u044C
    \u0441\u0438\u043B\u043E\u0439. \u041E\u043D \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442,
    \u043F\u043E\u043D\u044F\u043B \u043B\u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C
    \u0441\u0432\u044F\u0437\u044C \u043C\u0435\u0436\u0434\u0443 \u043F\u0430\u043C\u044F\u0442\u044C\u044E,
    \u0432\u044B\u0431\u043E\u0440\u043E\u043C \u0438 \u0446\u0435\u043B\u044C\u044E."
  highlightColor: {r: 1, g: 0.84, b: 0.32, a: 1}
  highlightLight: {fileID: 1623376119}
  prompt: E - read memory shard
