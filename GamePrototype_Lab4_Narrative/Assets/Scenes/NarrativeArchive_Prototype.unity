  noteTitle: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 I: \u041D\u0443\u043B\u0435\u0432\u043E\u0439
    \u0437\u0430\u043B"
  noteContent: "\u0412 \u0430\u0440\u0445\u0438\u0432\u0435 \u043D\u0435\u0442 \u0434\u0432\u0435\u0440\u0435\u0439,
    \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044F.
    \u041F\u0435\u0440\u0432\u044B\u0435 \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0438
    \u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u0432\u044B\u0445\u043E\u0434, \u043A\u043E\u0433\u0434\u0430
    \u0433\u043E\u0440\u043E\u0434 \u043D\u0430\u0447\u0430\u043B \u0437\u0430\u0431\u044B\u0432\u0430\u0442\u044C
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0438\u043C\u0435\u043D\u0430."
